{
  "name": "businessiq",
  "private": true,
  "version": "1.0.0",
  "description": "BusinessIQ - Business Management System (Desktop App & PWA)",
  "author": "Your Organization",
  "type": "module",
  "main": "electron-main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "dev:electron": "cross-env VITE_ELECTRON=true vite",
    "build": "vite build",
    "build:electron": "npx cross-env VITE_ELECTRON=true npx vite build && electron-builder",
    "build:electron:win": "npx cross-env VITE_ELECTRON=true npx vite build && electron-builder --win",
    "build:electron:mac": "npx cross-env VITE_ELECTRON=true npx vite build && electron-builder --mac",
    "build:electron:linux": "npx cross-env VITE_ELECTRON=true npx vite build && electron-builder --linux",
    "electron": "wait-on http://127.0.0.1:5175 && electron .",
    "start:electron": "cross-env NODE_ENV=development npm run dev:electron & npm run electron",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@heroicons/react": "^2.2.0",
    "antd": "^6.2.1",
    "axios": "^1.13.2",
    "better-sqlite3": "^12.9.0",
    "chart.js": "^4.5.1",
    "framer-motion": "^12.23.12",
    "fuse.js": "^7.1.0",
    "jspdf": "^3.0.3",
    "lucide-react": "^0.541.0",
    "react": "^19.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.6",
    "recharts": "^3.4.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/postcss7-compat": "^2.2.17",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "electron": "^32.0.0",
    "electron-builder": "^25.1.1",
    "electron-is-dev": "^2.0.0",
    "electron-updater": "^6.3.9",
    "eslint": "^9.34.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "terser": "^5.46.2",
    "vite": "^7.3.2",
    "wait-on": "^8.0.1"
  }
}
